{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "~/instrumentation": ["./instrumentation.ts"],
      "storefrontapi.generated": ["./storefrontapi.generated.d.ts"],
      "customer-accountapi.generated": ["./customer-accountapi.generated.d.ts"]
    },
    "plugins": [{"name": "next"}]
  },
  "include": ["next-env.d.ts", "env.d.ts", "*.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
