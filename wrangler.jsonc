{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "headless",
  "keep_vars": true,
	"compatibility_date": "2026-11-14",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "headless"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// One codebase, one Worker per brand. Deploy: opennextjs-cloudflare deploy --env <brand>
	// Bindings and routes are not inherited, so each brand repeats them.
	"env": {
		"bicyclebio": {
			"name": "headless-bicyclebio",
			"routes": [
				{"pattern": "bicyclebio.com", "custom_domain": true},
				{"pattern": "www.bicyclebio.com", "custom_domain": true}
			],
			"services": [{"binding": "WORKER_SELF_REFERENCE", "service": "headless-bicyclebio"}],
			"images": {"binding": "IMAGES"}
		},
		"skaterbio": {
			"name": "headless-skaterbio",
			"routes": [
				{"pattern": "skaterbio.com", "custom_domain": true},
				{"pattern": "www.skaterbio.com", "custom_domain": true}
			],
			"services": [{"binding": "WORKER_SELF_REFERENCE", "service": "headless-skaterbio"}],
			"images": {"binding": "IMAGES"}
		},
		"scooterbio": {
			"name": "headless-scooterbio",
			"routes": [
				{"pattern": "scooterbio.com", "custom_domain": true},
				{"pattern": "www.scooterbio.com", "custom_domain": true}
			],
			"services": [{"binding": "WORKER_SELF_REFERENCE", "service": "headless-scooterbio"}],
			"images": {"binding": "IMAGES"}
		}
	}
}
