{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "headless",
	"keep_vars": true,
	"compatibility_date": "2026-11-14",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "headless"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// One codebase, one Worker per brand. Deploy: opennextjs-cloudflare deploy --env <brand>
	// Bindings and routes are not inherited, so each brand repeats them.
	"env": {
		"bicyclebio": {
			"name": "headless-bicyclebio",
			"routes": [
				{
					"pattern": "bicyclebio.com",
					"custom_domain": true
				},
				{
					"pattern": "www.bicyclebio.com",
					"custom_domain": true
				},
				{
					"pattern": "auth.bicyclebio.com",
					"custom_domain": true
				}
			],
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "headless-bicyclebio"
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			// Sign-in database (P1.4). Same binding name on every brand.
			"d1_databases": [
				{
					"binding": "AUTH_DB",
					"database_name": "headless-auth-bicyclebio",
					"database_id": "037a08c9-8ecc-4877-8d37-077d24faa28a",
					"migrations_dir": "migrations/auth"
				}
			]
		},
		"skaterbio": {
			"name": "headless-skaterbio",
			"routes": [
				{
					"pattern": "skaterbio.com",
					"custom_domain": true
				},
				{
					"pattern": "www.skaterbio.com",
					"custom_domain": true
				},
				{
					"pattern": "auth.skaterbio.com",
					"custom_domain": true
				}
			],
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "headless-skaterbio"
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			// Sign-in database (P1.4). Same binding name on every brand.
			"d1_databases": [
				{
					"binding": "AUTH_DB",
					"database_name": "headless-auth-skaterbio",
					"database_id": "97d9b063-4107-4f29-b4b7-67d682e76d81",
					"migrations_dir": "migrations/auth"
				}
			]
		},
		"scooterbio": {
			"name": "headless-scooterbio",
			"routes": [
				{
					"pattern": "scooterbio.com",
					"custom_domain": true
				},
				{
					"pattern": "www.scooterbio.com",
					"custom_domain": true
				},
				{
					"pattern": "auth.scooterbio.com",
					"custom_domain": true
				}
			],
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "headless-scooterbio"
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			// Sign-in database (P1.4). Same binding name on every brand.
			"d1_databases": [
				{
					"binding": "AUTH_DB",
					"database_name": "headless-auth-scooterbio",
					"database_id": "cff24ca6-774a-4838-b245-368093490159",
					"migrations_dir": "migrations/auth"
				}
			]
		}
	},
	// Local dev only: a local copy of the sign-in database (never the live one).
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "headless-auth-local",
			"database_id": "local-headless-auth",
			"migrations_dir": "migrations/auth"
		}
	]
}